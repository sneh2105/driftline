{
  "permissions": {
    "allow": [
      "Edit", "Write", "Read", "Glob", "Grep",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git checkout:*)", "Bash(git branch:*)",
      "Bash(git fetch:*)", "Bash(git merge:*)", "Bash(git rev-parse:*)",
      "Bash(python:*)", "Bash(pytest:*)", "Bash(pip install:*)",
      "Bash(npm install:*)", "Bash(npm run build:*)", "Bash(npm ci:*)"
    ],
    "deny": [
      "Edit(tests/qa/**)",
      "Bash(git push:*)", "Bash(git reset --hard:*)", "Bash(git clean:*)",
      "Bash(rm:*)", "Bash(Remove-Item:*)", "Bash(git checkout main:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "python .claude/hooks/log_edit.py" }]
      }
    ]
  }
}

